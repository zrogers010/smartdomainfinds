# Production environment for SmartDomainFinds.
#
# Copy this to the server at /etc/smartdomainfinds/env (NOT into the repo) and
# lock it down:
#
#   sudo mkdir -p /etc/smartdomainfinds
#   sudo cp deploy/env.production.example /etc/smartdomainfinds/env
#   sudo chown root:deploy /etc/smartdomainfinds/env
#   sudo chmod 640 /etc/smartdomainfinds/env
#
# The systemd unit loads this via EnvironmentFile; deploy.sh also sources the
# NEXT_PUBLIC_* values at build time.

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Real availability via RDAP — no API key required.
DOMAIN_PROVIDER=rdap

# --- AI is OFF ---
# Leave both OPENAI_API_KEY and OPENAI_BASE_URL empty to use the built-in
# deterministic demo generator (zero AI cost, no external calls).
#
# To enable AI later, set a provider (no redeploy of code needed, just restart):
#   Cheap hosted open model (recommended):
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_API_KEY=gsk_...
#     OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenAI:
#     OPENAI_API_KEY=sk-...
#     OPENAI_MODEL=gpt-4o-mini
#   Local Ollama on this box (needs more RAM/CPU or a GPU instance):
#     OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#     OPENAI_MODEL=llama3.1:8b
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-5.5
# OPENAI_JSON_MODE=true

# Public site URL (baked into the client at build time — must be set before `next build`).
NEXT_PUBLIC_APP_URL=https://smartdomainfinds.com

# Google Analytics 4 Measurement ID. Loaded only when set; inlined at build time.
NEXT_PUBLIC_GA_ID=G-PKZL8Z63Y6
