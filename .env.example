# --- AI generation (optional) ---
# AI is "on" when EITHER OPENAI_API_KEY or OPENAI_BASE_URL is set. When both are
# empty, the app falls back to the high-quality seeded demo generator so it works
# end-to-end with zero config (and zero cost).
#
# The client speaks the OpenAI chat-completions API, so any compatible provider
# works by setting the three vars below. Presets:
#
#   OpenAI     OPENAI_API_KEY=sk-...            OPENAI_MODEL=gpt-4o-mini
#   Groq       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#              OPENAI_API_KEY=gsk_...           OPENAI_MODEL=llama-3.3-70b-versatile
#   Together   OPENAI_BASE_URL=https://api.together.xyz/v1
#              OPENAI_API_KEY=...               OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   DeepInfra  OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
#              OPENAI_API_KEY=...               OPENAI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
#   Ollama     OPENAI_BASE_URL=http://localhost:11434/v1   (no key needed)
#              OPENAI_MODEL=llama3.1:8b
#
# If a local/open endpoint rejects JSON mode, set OPENAI_JSON_MODE=false.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=
# OPENAI_JSON_MODE=true

# --- Domain availability provider ---
# One of: rdap | mock | domainr | namecheap
#
# rdap  (default): REAL availability via RDAP (the authoritative WHOIS
#                  replacement). No API key required. Reliable for .com, .net,
#                  .ai, .app, .org, .dev; other TLDs (e.g. .io, .co) report
#                  "unknown" because they lack public RDAP coverage.
# mock           : deterministic fake data for offline UI development.
# domainr/namecheap: stubbed adapters (need keys + implementation).
DOMAIN_PROVIDER=rdap

# Domainr (https://domainr.com/docs/api) — used when DOMAIN_PROVIDER=domainr
DOMAINR_API_KEY=

# Namecheap (https://www.namecheap.com/support/api/) — used when DOMAIN_PROVIDER=namecheap
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID. When set, GA loads via @next/third-parties.
# Leave empty in local dev to avoid polluting analytics with dev traffic.
NEXT_PUBLIC_GA_ID=

# --- ENS / web3 tool (optional) ---
# The ENS (.eth) checker uses key-free public Ethereum RPC endpoints by default.
# Set your own (e.g. Alchemy/Infura) to use as the primary for higher limits.
ETH_RPC_URL=

# --- Search Console (optional) ---
# Google Search Console verification token. If you verify via the HTML-tag
# method, paste just the token (the `content` value) here and it's added to the
# <head>. Easier alternative: verify via a DNS TXT record at your DNS host.
GOOGLE_SITE_VERIFICATION=
